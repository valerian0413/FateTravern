LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=your-api-key
LLM_MODEL=your-model
LLM_TIMEOUT=90
LLM_CONCURRENCY=4
DB_PATH=data/engine.sqlite3
HOST=127.0.0.1
PORT=8000
LOG_DIR=logs
PROMPT_VERSION=2026-11-12-v1
NARRATION_MAX_CHARS=180

# auto: official DeepSeek hostname enables DeepSeek-specific parameters.
# Use deepseek for a compatible proxy; openai_compatible omits thinking fields.
LLM_PROVIDER=auto
LLM_JSON_OUTPUT=true
LLM_THINKING=disabled
LLM_REASONING_EFFORT=low
# true：模型按流式返回，页面边生成边显示可见文字。服务不支持时可设为 false。
LLM_STREAM=true

# 中文向量检索。模型安装命令见 README。
MEMORY_VECTOR=true
# MEMORY_MODEL_DIR=data/embedding-model
